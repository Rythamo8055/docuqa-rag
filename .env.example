# ── LLM providers (set at least one) ─────────────────────
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: local LLM via Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Optional: tracing (Langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: persistence overrides (Render disk etc.)
# DATA_DIR=/data/chroma_db
# CACHE_PATH=/data/rag_cache.sqlite